{
  "name": "soulcraft-copilot",
  "version": "3.0.0",
  "description": "Production-grade DJ release copilot, Engine DJ session parser, and SoundCloud optimizer",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "test:cli": "tsx src/cli/testRunner.ts",
    "test": "vitest run",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@google/genai": "^2.23.0",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "^0.1.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "lucide-react": "^0.439.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
